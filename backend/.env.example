# Copy to backend/.env and adjust. Every variable is optional.

# --- server ---
CLIPPER_HOST=127.0.0.1
CLIPPER_PORT=8000
# CLIPPER_API_TOKEN=change-me            # required on every request when set (UI: Configuración → Acceso a la API)
# CLIPPER_PUBLIC_BASE_URL=https://clipper.example.com   # OAuth redirects + Kick webhooks

# --- storage ---
CLIPPER_DATA_DIR=./data
# CLIPPER_DATABASE_URL=postgresql+asyncpg://user:pass@localhost/clipper   # default: SQLite in data dir
CLIPPER_DISK_MIN_FREE_GB=2
CLIPPER_SOURCE_RETENTION_DAYS=14
# CLIPPER_SECRET_KEY=                    # Fernet key for stored credentials (auto-generated in data dir if empty)

# --- workers ---
CLIPPER_QUEUE_BACKEND=local              # local | redis
# CLIPPER_REDIS_URL=redis://localhost:6379/0
CLIPPER_RENDER_CONCURRENCY=1
CLIPPER_MAX_STREAMS=8

# --- speech recognition (faster-whisper) ---
CLIPPER_WHISPER_MODEL=small              # tiny | base | small | medium | large-v3 | large-v3-turbo
CLIPPER_WHISPER_DEVICE=auto              # auto | cpu | cuda
# CLIPPER_WHISPER_LANGUAGE=es            # empty = auto-detect

# --- contextual analysis (optional LLM) ---
CLIPPER_LLM_PROVIDER=none                # none | ollama | openai | anthropic
# CLIPPER_LLM_MODEL=qwen2.5:7b-instruct
# CLIPPER_LLM_BASE_URL=http://localhost:11434
# CLIPPER_LLM_API_KEY=
# CLIPPER_LLM_VISION=false

# --- platforms (official APIs) ---
# CLIPPER_TWITCH_CLIENT_ID=
# CLIPPER_TWITCH_CLIENT_SECRET=
# CLIPPER_YOUTUBE_API_KEY=
# CLIPPER_YOUTUBE_COOKIES_FILE=          # cookies.txt of your own account, only if YouTube asks for bot verification
# CLIPPER_GOOGLE_CLIENT_ID=              # OAuth for YouTube Analytics (Shorts metrics)
# CLIPPER_GOOGLE_CLIENT_SECRET=
# CLIPPER_KICK_CLIENT_ID=
# CLIPPER_KICK_CLIENT_SECRET=
CLIPPER_KICK_UNOFFICIAL_CHAT=false
